        <mxCell id="RZV44nI7FpgGCSOGNcCN-18" value="将 {城市, 最终得分, 等级, Severity, Prevalence, 高风险台区明细} 加入 result_list" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="177" y="3092" width="242" height="101" as="geometry" />
