        <mxCell id="RZV44nI7FpgGCSOGNcCN-1" value="开始" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="804" y="20" width="92" height="49" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-2" value="输入: List&amp;lt;台区数据&amp;gt;" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="730" y="119" width="241" height="241" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-3" value="初始化 result_list = []" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="743" y="409" width="214" height="49" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-4" value="按 city 字段对所有台区进行分组" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="729" y="508" width="242" height="242" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-5" value="For each 城市分组 group" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="738" y="800" width="225" height="225" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-6" value="计算基础统计量: N, H, U_total" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="395" y="1149" width="220" height="66" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-7" value="计算加权平均风险 (Severity)" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="408" y="1362" width="194" height="194" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-8" value="IF U_total == 0" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="428" y="1606" width="155" height="155" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-9" value="Severity = avg(group.R_value)" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="279" y="1851" width="199" height="66" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-10" value="Severity = sum(group.R_value * group.user_count) / U_total" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="528" y="1834" width="208" height="101" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-11" value="计算高风险占比百分制 (Prevalence) = (H / N) * 100" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="375" y="1985" width="259" height="66" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-12" value="综合计算区域风险指数 (R_city) = (Severity * 0.7) + (Prevalence * 0.3)" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="377" y="2101" width="255" height="84" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-13" value="R_city = min(R_city, 100)" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="385" y="2235" width="239" height="49" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-14" value="硬性干预规则: IF group.中压停电总次数 &gt;= 3 OR group.重大敏感投诉事件 == True" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="347" y="2334" width="315" height="315" as="geometry" />
        </mxCell>
        <mxCell id="RZV44nI7FpgGCSOGNcCN-15" value="依据 R_city 映射等级" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
